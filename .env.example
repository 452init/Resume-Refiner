# Optional hosted model providers for the server-side API workflow.
# Never expose these values to client-side Vite code.
AI_PROVIDER=mistral
# Use a current model ID available in your provider account. Mistral Small 4 is
# the efficient hybrid instruct/reasoning choice; Mistral Medium 3.5 is the
# stronger quality choice for analyst and formatting review agents.
AI_MODEL=mistral-small-latest
AI_ANALYST_MODEL=mistral-medium-latest
AI_EDITOR_MODEL=mistral-small-latest
AI_FORMATTER_MODEL=mistral-medium-latest
AI_VARIATIONS_MODEL=mistral-small-latest
MISTRAL_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MISTRAL_MODEL=mistral-small-latest
GROQ_MODEL=llama-3.3-70b-versatile
